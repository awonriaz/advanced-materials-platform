APP_ENV=demo
APP_NAME=Advanced Materials Supply Chain Platform

# Generated by scripts/init_env.*. Keep blank in template. Never commit .env.
API_KEY=
MQTT_USERNAME=amscp_demo
MQTT_PASSWORD=

DB_PATH=/app/data/amscp.db
MAX_UPLOAD_MB=8
QC_FAIL_THRESHOLD=32.0

ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_TIMEOUT_SECONDS=3
SEARCH_INDEX=material-passports
TENSORFLOW_QC_URL=http://tensorflow-qc:8501

# TensorFlow QC service settings
MODEL_PATH=/app/models/material_qc.keras
DATASET_DIR=/app/sample_data
IMG_SIZE=128
DEFECT_THRESHOLD=0.60
